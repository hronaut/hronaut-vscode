{
  "name": "hronaut",
  "displayName": "Hronaut",
  "description": "Give your coding agent its own browser. Keep yours. Connects your agent to Hronaut, a visible desktop browser for coding agents, with a separate workspace for each project. Requires the Hronaut app (10-day free trial at hronaut.dev).",
  "version": "3.12.2",
  "publisher": "hronaut",
  "license": "MIT",
  "pricing": "Trial",
  "icon": "icon.png",
  "homepage": "https://hronaut.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/hronaut/hronaut-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/hronaut/hronaut/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["AI", "Testing"],
  "keywords": ["mcp", "browser", "agent", "copilot", "localhost", "qa"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "files": ["extension.js", "connection.js", "icon.png", "LICENSE.md", "README.md", "CHANGELOG.md"],
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "hronaut",
        "label": "Hronaut"
      }
    ],
    "configuration": {
      "title": "Hronaut",
      "properties": {
        "hronaut.mcpPort": {
          "type": "integer",
          "default": 47812,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "ignoreSync": true,
          "markdownDescription": "The port of Hronaut's MCP server on this computer. Set it only if you changed it in Hronaut's **Settings → MCP security**. As in Hronaut, `HRONAUT_MCP_PORT` comes first if the editor has it."
        }
      }
    }
  }
}
